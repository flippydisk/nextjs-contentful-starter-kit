# Contentful
CONTENTFUL_ENV=master
CONTENTFUL_SPACE_ID=your_contentful_space_id
CONTENTFUL_CONTENT_DELIVERY_API_ACCESS_TOKEN=your_content_delivery_api_access_token
CONTENTFUL_CONTENT_PREVIEW_API_ACCESS_TOKEN=your_content_preview_api_access_token
CONTENTFUL_MIGRATION_TOKEN=your_contentful_management_token
CONTENTFUL_PREVIEW_SECRET=make_this_a_long_url_safe_random_string

# Site
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_PROTOCOL=https://
NEXT_PUBLIC_SITE_URL=https://localhost:3000
NEXT_PUBLIC_SITE_SLOGAN='Next.js + Contentful Starter Kit'

# Optional external API target used by API proxy helpers in apps that add one.
NEXT_PUBLIC_API_TARGET=local
NEXT_PUBLIC_LOCAL_API_URL=https://localhost:8080
